# Copie para .env; nunca suba .env ao Git
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa-antes-de-rodar
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Banco local descartável do compose.yaml. Gere DB_PASSWORD no .env ignorado pelo Git.
# Para executar apenas os testes sem banco, use DB_DISABLED=true no processo.
DB_NAME=labtech_local
DB_DISABLED=false
DB_USER=labtech
DB_PASSWORD=gere-uma-senha-local
DB_HOST=127.0.0.1
DB_PORT=55432
