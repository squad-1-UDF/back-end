# Copie para .env; nunca suba .env ao Git
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa-antes-de-rodar
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# A equipe de banco fornecerá esses valores e o schema.
# Deixe DB_NAME vazio enquanto não tiver o PostgreSQL disponível.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
